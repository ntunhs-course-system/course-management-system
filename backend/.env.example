PORT=3000
NODE_ENV=development

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 不填會自動找 ../database/courses.db，沒有的話用 ../courses.db
COURSE_DB_PATH=
# 不設就用預設 backend/data/app.db；要設請填絕對路徑
# （database/init_app_db.py 不會讀 .env，相對路徑會從執行指令的資料夾算起，兩邊會指到不同的 app.db）
# APP_DB_PATH=

# npm run seed:users，密碼至少 8 個字
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STUDENT_USERNAME=student
STUDENT_PASSWORD=
